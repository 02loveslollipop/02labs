{
	"name": "02labs-www",
	"compatibility_date": "2026-02-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		}
	},
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Invoke the worker for every request so host redirects and the
		// Accept: text/markdown handling in src/worker.ts apply to all paths.
		"run_worker_first": true
	}
}
