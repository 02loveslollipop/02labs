---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";
import Breadcrumb from "../../components/ds/Breadcrumb.astro";
import Footer from "../../components/sections/Footer.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const entries = await getCollection("projects");
	return entries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { project: entry.data },
	}));
}

const { project } = Astro.props;
const projectUrl = Astro.site
	? new URL(`/projects/${project.slug}/`, Astro.site).toString()
	: `/projects/${project.slug}/`;
const jsonLd = JSON.stringify(
	[
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "02Labs",
					item: Astro.site ? new URL("/", Astro.site).toString() : "/",
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "Projects",
					item: Astro.site ? new URL("/projects/", Astro.site).toString() : "/projects/",
				},
				{
					"@type": "ListItem",
					position: 3,
					name: project.title,
					item: projectUrl,
				},
			],
		},
		{
			"@context": "https://schema.org",
			"@type": "WebPage",
			name: project.title,
			description: project.summary,
			url: projectUrl,
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "02Labs",
						item: Astro.site ? new URL("/", Astro.site).toString() : "/",
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "Projects",
						item: Astro.site ? new URL("/projects/", Astro.site).toString() : "/projects/",
					},
					{
						"@type": "ListItem",
						position: 3,
						name: project.title,
						item: projectUrl,
					},
				],
			},
			isPartOf: {
				"@type": "WebSite",
				name: "02Labs",
				url: Astro.site ? new URL("/", Astro.site).toString() : "/",
			},
		},
	],
	null,
	0
);
---

<BaseLayout
	title={project.title}
	description={project.summary}
	ogType="website"
	jsonLd={jsonLd}
>
	<Navbar forceScrolled />

	<main id="main" class="project-page">
		<div class="project-page__shell panel">
			<Breadcrumb
				items={[
					{ label: "Home", href: "/" },
					{ label: "Projects", href: "/projects/" },
					{ label: project.title },
				]}
			/>

			<ProjectDetail project={project} headingTag="h1" />
		</div>
	</main>

	<Footer backToTopHref="/projects/" />
</BaseLayout>
