---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import IntroSection from "../components/sections/IntroSection.astro";
import Ch0wn3rsSection from "../components/sections/Ch0wn3rsSection.astro";
import BlogSection from "../components/sections/BlogSection.astro";
import FeaturedProjectsSection from "../components/sections/FeaturedProjectsSection.astro";
import Footer from "../components/sections/Footer.astro";
import ProjectDetail from "../components/ProjectDetail.astro";
import { getCollection } from "astro:content";
import { fetchLatestBlogPosts } from "../lib/blog";
import { getCTFTimeData, getTopCTFPerformances } from "../lib/ctftime";

const ctf = getCTFTimeData();
const team = ctf.team;
const topEvents = getTopCTFPerformances(ctf.events, 5);
const ctfYear = ctf.year;

const entries = await getCollection("projects");
const projects = entries.map((e) => e.data).sort((a, b) => a.order - b.order);
const featured = projects.filter((p) => p.featured).slice(0, 5);

const jsonLd = JSON.stringify(
	[
		{
			"@context": "https://schema.org",
			"@type": "Person",
			name: "02loveslollipop",
			jobTitle: "Computer and systems engineer & Data science engineer",
			url: "https://02labs.me/",
			sameAs: [
				"https://github.com/02loveslollipop",
				"https://ctftime.org/team/408704",
				"https://blog.02labs.me/",
			],
		},
		{
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "02Labs",
			alternateName: ["02loveslollipop", "02Labs"],
			url: "https://02labs.me/",
			hasPart: {
				"@type": "Blog",
				name: "02Labs Blog",
				url: "https://blog.02labs.me/",
			},
		},
	],
	null,
	0
);

// ---------- Blog RSS fetch ----------
const blogPosts = await fetchLatestBlogPosts(4);
if (import.meta.env.PROD && blogPosts.length === 0) {
	throw new Error(
		"Blog mirror returned 0 posts — aborting the build instead of deploying a homepage without posts."
	);
}
---

<BaseLayout
	title="Systems, Data, Projects, and CTF Writeups"
	description="02Labs is the portfolio and lab of 02loveslollipop, featuring systems engineering projects, data work, security experiments, and technical writeups."
	ogType="website"
	canonical="https://02labs.me/"
	jsonLd={jsonLd}
>
	<Navbar />
	<main id="main" class="home-main">
		<div class="card-stack">
			<Hero />
			<IntroSection />
			<Ch0wn3rsSection team={team} year={ctfYear} topEvents={topEvents} />
			<BlogSection posts={blogPosts} />
			<FeaturedProjectsSection featured={featured} />

			{
				featured.map((project) => (
					<section
						class="snap-section"
						id={`project-${project.slug}`}
						data-snap-section
					>
						<div class="panel panel--centered">
							<div class="panel__body">
								<ProjectDetail project={project} />
							</div>
						</div>
					</section>
				))
			}
		</div><!-- .card-stack -->
	</main>

	<Footer />

	<script>
		import "../scripts/home";

		// Carousel logic for featured projects
		const rows = document.querySelectorAll(".featured-row");
		const prevBtns = document.querySelectorAll(".prev-btn");
		const nextBtns = document.querySelectorAll(".next-btn");

		rows.forEach((row, index) => {
			const prev = prevBtns[index];
			const next = nextBtns[index];
			if (row && prev && next) {
				prev.addEventListener("click", () => {
					row.scrollBy({ left: -row.clientWidth * 0.8, behavior: "smooth" });
				});
				next.addEventListener("click", () => {
					row.scrollBy({ left: row.clientWidth * 0.8, behavior: "smooth" });
				});
			}
		});
	</script>
</BaseLayout>
