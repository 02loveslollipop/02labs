---
/**
 * 02Labs Design System: IntroSection Component
 *
 * Mapped to:
 * - GitHub Primer: 2-column Box / Layout
 * - AWS Cloudscape: Container + ColumnLayout (columns={2})
 */
export interface Props {
	introTitle?: string;
	introText?: string;
	focusTitle?: string;
	focusText?: string;
	id?: string;
}

const {
	introTitle = "Introduction",
	introText = "Hi, I'm 02loveslollipop. 02Labs is my personal portfolio and lab, where I share projects, writeups, and experiments across systems engineering, data, security, and the other technical areas I like to explore deeply.",
	focusTitle = "Focus (Or lack thereof)",
	focusText = "I love lot's of things as you will see in my projects and blog. I think the best way to understand the world is by building, but something shouldn't be built just for the sake of building. I like to build things that are interesting, that solve problems, or that are just fun to me. But also I don't like to be superficial in what I learn whatever the topic is, for me that's a way to show respect to that thing and to myself.",
	id = "intro",
} = Astro.props;
---

<section class="snap-section" id={id} data-snap-section>
	<div class="panel intro">
		<div class="intro-grid">
			<div>
				<h2>{introTitle}</h2>
				<p>{introText}</p>
			</div>
			<div class="intro-divider" aria-hidden="true"></div>
			<div>
				<h2>{focusTitle}</h2>
				<p>{focusText}</p>
			</div>
		</div>
	</div>
</section>
